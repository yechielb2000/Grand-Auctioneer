rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Public auction preview projection only. Never store bids, bidder IDs,
    // seller-private data, balances, or settlement fields at this path.
    match /publicAuctions/{auctionId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    // Profile summaries are provisioned by a trusted/admin process. Clients
    // may read only their own minimal profile document.
    match /users/{uid}/profile/summary {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Competitive economy data and every unlisted collection are closed until
    // a trusted writer model is approved and implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
